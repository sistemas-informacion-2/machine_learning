# Conexion a Postgres con el usuario restringido del servicio (ver backend/docs/BI-DW.md): lee el esquema dw y
# escribe solo sus tablas dw.ml_*. Con Docker Compose el host es "db" en lugar de localhost.
ML_DATABASE_URL=postgresql+psycopg://bi_ml:CAMBIAR@localhost:5433/ecommerce

# La misma clave que ML_CLAVE_INTERNA en backend/.env. Sin clave, el servicio rechaza todos los pedidos.
ML_CLAVE_INTERNA=
